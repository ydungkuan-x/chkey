import { AppFooter } from "./components/AppFooter.slint";
import { I18nTexts } from "./models/I18nTexts.slint";
import { AppConfig } from "./models/AppConfig.slint";
import { App } from "./App.slint";
import { Theme } from "./Theme.slint";
import { UpdateWindow } from "./UpdateDialog.slint";
export { UpdateWindow }
export component MainWindow inherits Window {
    // ========================================
    // 1. Properties
    // ========================================

    // Trạng thái giao diện
    in-out property <bool> dark-mode: false;
    in-out property <bool> overlay-visible: false;

    // Ngôn ngữ và phiên bản
    in-out property <string> lang: "vi";
    in-out property <string> current-version;

    // Dữ liệu ứng dụng
    in-out property <AppConfig> app-config;
    in-out property <I18nTexts> i18n;

    // ========================================
    // 2. Callbacks
    // ========================================

    callback action-clicked(string);
    callback setting-changed(string, bool);
    callback input-settings-changed(string, string);
    callback language-changed(string);

    // ========================================
    // 3. Property Bindings
    // ========================================

    changed dark-mode => {
        Theme.dark-mode = root.dark-mode;
    }

    // ========================================
    // 4. Window Properties
    // ========================================

    icon: @image-url("../../chkey.png");
    title: "CHKey " + root.current-version;

    width: 426px;
    height: 206px;

    background: Theme.bg;
    default-font-size: 12px;

    // ========================================
    // 5. UI Components
    // ========================================

    VerticalLayout {
        padding: 10px;
        alignment: space-between;

        App {
            width: 100%;
            i18n: root.i18n;
            app-config: root.app-config;
            action-clicked(action) => { root.action-clicked(action); }
            setting-changed(key, value) => { root.setting-changed(key, value); }
            input-settings-changed(key, value) => { root.input-settings-changed(key, value); }
        }

        AppFooter {
            i18n: root.i18n;
            lang: root.lang;
            language-changed(lang) => { root.language-changed(lang); }
            action-clicked(action) => { root.action-clicked(action); }
        }
    }

    // Lớp phủ vô hiệu hóa giao diện
    if root.overlay-visible: Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.bg;
        opacity: 0.3;

        TouchArea {
            width: 100%;
            height: 100%;
        }
    }
}
