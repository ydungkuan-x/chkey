import { AppComboBox } from "./AppComboBox.slint";
import { AppLink } from "./AppLink.slint";
import { Theme } from "../Theme.slint";
import { I18nTexts } from "../models/I18nTexts.slint";

export component AppFooter inherits HorizontalLayout {
    in-out property <string> lang: "vi";
    in property <I18nTexts> i18n;
    callback language-changed(string);
    callback action-clicked(string);

    spacing: 10px;
    alignment: space-between;
    width: 100%;
    height: 20px;
    padding-left: 2px;
    padding-right: 0;

    HorizontalLayout {
        height: 100%;
        alignment: start;
        spacing: 5px;

        Text {
            height: 100%;
            text: root.i18n.about-copyright;
            font-weight: 400;
            wrap: word-wrap;
            line-height-factor: 1.3;
            vertical-alignment: bottom;
            color: Theme.text-secondary;
            font-size: 11px;
        }

        Text {
            height: 100%;
            text: "●";
            font-weight: 400;
            wrap: word-wrap;
            line-height-factor: 1.3;
            vertical-alignment: bottom;
            color: Theme.text-secondary;
            font-size: 11px;
        }

        AppLink {
            text: root.i18n.help;
            font-size: 11px;
            text-vertical-alignment: bottom;
            clicked => {
                root.action-clicked("guide");
            }
        }
    }

    // Danh sách mã ngôn ngữ tương ứng 1-1 với danh sách hiển thị
    property <[string]> lang-codes: [
        "vi",
        "en",
        "ede",
    ];

    AppComboBox {
        y: -1px;
        width: 94px;
        height: 20px;
        model: [
            "Tiếng Việt",
            "English",
            "Êđê",
        ];
        current-index: root.lang == "en" ? 1 : (root.lang == "ede" ? 2 : 0);

        selected(index) => {
            if (index < root.lang-codes.length) {
                root.lang = root.lang-codes[index];
                root.language-changed(root.lang);
            }
        }
    }
}
