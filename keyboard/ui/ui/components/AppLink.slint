import { Theme } from "../Theme.slint";

export component AppLink inherits Rectangle {
    in property <string> text: "";
    in property <length> font-size: 11px;
    in property <TextVerticalAlignment> text-vertical-alignment: center;

    callback clicked();

    height: 100%;

    Text {
        height: 100%;
        text: root.text;
        font-size: root.font-size;
        font-weight: 400;
        wrap: word-wrap;
        line-height-factor: 1.3;
        vertical-alignment: root.text-vertical-alignment;
        color: touch.has-hover ? Theme.accent.darker(15%) : Theme.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
