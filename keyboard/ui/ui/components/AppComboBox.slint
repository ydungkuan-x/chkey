import { Theme } from "../Theme.slint";

export component AppComboBox inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> open-upward: true;
    callback selected(int);

    width: 84px;
    height: 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;

    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: space-between;

        Text {
            text: root.model[root.current-index];
            color: Theme.text-primary;
            font-size: 11px;
            vertical-alignment: center;
        }

        Image {
            source: @image-url("../../assets/icons/arrow-down.svg");
            width: 6px;
            height: 4px;
            vertical-alignment: center;
            y: 8px;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.open-upward ? - (root.model.length * 23px + 6px) : (root.height + 2px);
        width: root.width;

        Rectangle {
            background: Theme.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                padding: 2px;
                spacing: 1px;

                for item[index] in root.model: Rectangle {
                    height: 22px;
                    border-radius: 3px;
                    background: item-touch.has-hover
                        ? Theme.surface-hover
                        : (root.current-index == index ? (Theme.dark-mode ? #333333 : #EAEAEA) : transparent);

                    Text {
                        x: 8px;
                        text: item;
                        color: root.current-index == index ? Theme.accent : Theme.text-primary;
                        font-size: 11px;
                        font-weight: root.current-index == index ? 500 : 400;
                        vertical-alignment: center;
                    }

                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}
