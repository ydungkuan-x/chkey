import { Theme } from "../Theme.slint";

export component AppGroupBox inherits Rectangle {
    in property <string> title: "";
    in property <length> spacing: 16px;
    in property <length> content-padding: 12px;
    in property <length> content-padding-top: 20px;

    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.border;

        // Header bọc title: đặt alignment: start để chỉ chiếm đúng chiều rộng của tiêu đề
        HorizontalLayout {
            y: -7px;
            x: 8px;
            alignment: start;

            Rectangle {
                background: Theme.bg;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;

                    Text {
                        text: root.title;
                        font-weight: 500;
                        color: Theme.text-primary;
                    }
                }
            }
        }

        VerticalLayout {
            width: 100%;
            spacing: root.spacing;
            padding: root.content-padding;
            padding-top: root.content-padding-top;
            alignment: start;

            @children
        }
    }
}
